# cp .env.example .env 후 필요한 값만 수정

# 외부 노출 포트 (요구사항: 3040)
WEB_PORT=3040

# 세션 쿠키 서명 키 — 반드시 바꿀 것: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# Postgres
POSTGRES_USER=chatchat
POSTGRES_PASSWORD=chatchat
POSTGRES_DB=chatchat
# 호스트에서 psql 로 붙고 싶을 때만 사용 (compose 에서 주석 해제 필요)
DB_HOST_PORT=5433

# 호스트에서 네이티브로 도는 Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen3.6:27b-mlx
EXTRACT_MODEL=gemma4:e4b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# 저장소 최상위 (호스트 경로). 이 아래에 사용자별 <username>/{nas,trash,tmp} 가 생긴다.
NAS_HOST_PATH=./data/nas

# ── 그래프 추출을 외부 API 로 가속하고 싶을 때만 (선택) ──
# 로컬 모델은 청크당 수 초씩 걸려 논문 PDF 한 건에도 수 분이 든다.
# 키를 넣고 make restart 한 뒤 설정 → RAG 에서 추출 제공자를 deepseek 으로 바꾸면 된다.
# 키는 DB(설정 API)에 저장하지 않고 이 파일에만 둔다.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Notion 크롤 (선택) ──
# 웹(Notion 탭)에서 넣는 게 기본이고, 여기 두면 그쪽이 우선한다.
# notion.so/my-integrations 에서 내부 통합을 만들고, 읽을 페이지마다 ··· → 연결 로 추가한다.
NOTION_TOKEN=
