# cp .env.example .env 후 필요한 값만 수정

# 외부 노출 포트 (요구사항: 3040)
WEB_PORT=3040

# 세션 쿠키 서명 키 — 반드시 바꿀 것: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# Postgres
POSTGRES_USER=chatchat
POSTGRES_PASSWORD=chatchat
POSTGRES_DB=chatchat
# 호스트에서 psql 로 붙고 싶을 때만 사용 (compose 에서 주석 해제 필요)
DB_HOST_PORT=5433

# 호스트에서 네이티브로 도는 Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen3.6:27b-mlx
EXTRACT_MODEL=gemma4:e4b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# NAS 루트 (호스트 경로). 외장 디스크를 쓰려면 절대경로로 바꾸면 됨
NAS_HOST_PATH=./data/nas
